# ค่าตัวแปรระบบ (คัดลอกเป็น .env จริง — ห้าม commit .env)
# ThaiWater public API (ไม่ต้อง key)
THAIWATER_BASE_URL=https://api-v3.thaiwater.net/api/v1/thaiwater30/public
THAIWATER_PROVINCE_CODE=95
# TMD / GISTDA / DDPM (เติมเมื่อ Phase 1)
TMD_API_KEY=
GISTDA_TOKEN=
# Supabase (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Firebase Cloud Messaging (Phase 3)
FCM_SERVER_KEY=
# SOS webhook ศูนย์ปภ.ยะลา (Phase 1 backlog)
SOS_WEBHOOK_URL=
# Alert thresholds (formula_version=1)
ALERT_W_WATER=0.5
ALERT_W_RAIN=0.25
ALERT_W_FORECAST=0.15
ALERT_W_CROWD=0.10
